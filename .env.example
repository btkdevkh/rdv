# Copy to .env and fill in from the Appwrite console.
# Only EXPO_PUBLIC_* values belong here — they are embedded in the app bundle
# and readable by anyone who downloads it. Never put an Appwrite API key here.

# Console → your project → Settings → API Endpoint
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# Console → your project → Settings → Project ID
EXPO_PUBLIC_APPWRITE_PROJECT_ID=

# Must match the bundle identifier / package registered as a platform in
# Console → your project → Overview → Add platform.
EXPO_PUBLIC_APPWRITE_PLATFORM=com.btkdevkh.rdv

# Console → Databases → your database → Database ID
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
