{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
        "EXPO_PUBLIC_APPWRITE_PROJECT_ID": "rdv-app",
        "EXPO_PUBLIC_APPWRITE_PLATFORM": "com.btkdevkh.rdv",
        "EXPO_PUBLIC_APPWRITE_DATABASE_ID": "rdv-app-db"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
        "EXPO_PUBLIC_APPWRITE_PROJECT_ID": "rdv-app",
        "EXPO_PUBLIC_APPWRITE_PLATFORM": "com.btkdevkh.rdv",
        "EXPO_PUBLIC_APPWRITE_DATABASE_ID": "rdv-app-db"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
        "EXPO_PUBLIC_APPWRITE_PROJECT_ID": "rdv-app",
        "EXPO_PUBLIC_APPWRITE_PLATFORM": "com.btkdevkh.rdv",
        "EXPO_PUBLIC_APPWRITE_DATABASE_ID": "rdv-app-db"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
